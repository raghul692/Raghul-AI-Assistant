# ============================================================================
# RAGHUL AI — MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================

# ----------------------------------------------------------------------------
# 1. RENDER WEB SERVICE & BACKGROUND WORKER (SHARED INFRASTRUCTURE)
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
MAX_MEMORY_TURNS=14
ALLOWED_ORIGINS=https://raghulraja-portfolio.vercel.app,https://raghulraja.is-a.dev,http://localhost:3000

# Supabase PostgreSQL + pgvector (AWS region pooler connection string)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Background Worker Tuning
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL_MS=1500

# Administrative / Developer API Key for Privileged Endpoints
ADMIN_API_KEY=your_secure_admin_api_key_here

# ----------------------------------------------------------------------------
# 2. AI FRONTIER MODEL PROVIDERS
# ----------------------------------------------------------------------------
# Google Gemini (Default Primary)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_AGENT_DEFAULT_MODE=deep
GEMINI_FAST_MODEL=gemini-2.5-flash

# Groq Cloud (Ultra Low-Latency Fallback)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (Frontier Model Fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# NVIDIA NIM (Enterprise Fallback)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Cloudflare Workers AI (FLUX Image Generation & LLM Fallback)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Search API Integrations (Deep Research)
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here

# ----------------------------------------------------------------------------
# 3. GITHUB AUTOMATION & MCP GATEWAY
# ----------------------------------------------------------------------------
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_personal_access_token_here
GITHUB_OWNER=raghul692
GITHUB_REPOSITORY=raghulraja_portfolio
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ----------------------------------------------------------------------------
# 4. VERCEL FRONTEND CONFIGURATION
# ----------------------------------------------------------------------------
# Public API URL pointing to the Render Web Service
NEXT_PUBLIC_API_URL=https://raghul-ai-api.onrender.com
API_BASE_URL=https://raghul-ai-api.onrender.com
